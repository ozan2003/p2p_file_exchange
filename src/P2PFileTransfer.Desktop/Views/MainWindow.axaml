<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:P2PFileTransfer.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="P2PFileTransfer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="960"
        Height="640"
        Icon="/Assets/avalonia-logo.ico"
        Title="P2P File Transfer">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" />
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <TextBlock Text="Display Name:" VerticalAlignment="Center" />
            <TextBox Width="200" Text="{Binding DisplayName, Mode=TwoWay}" />
            <Button Content="Start Discovery" Command="{Binding StartDiscoveryCommand}" />
            <Button Content="Stop Discovery" Command="{Binding StopDiscoveryCommand}" />
            <Button Content="Send File" Command="{Binding SendFileCommand}" />
        </StackPanel>

        <Grid Margin="8" ColumnDefinitions="*,*">
            <Border Grid.Column="0" Margin="0,0,8,0" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Discovered Peers" FontWeight="Bold" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PeerItemViewModel">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Endpoint}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Active Transfers" FontWeight="Bold" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding Transfers}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferItemViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding RemoteEndpoint}" FontSize="11" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
