<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:P2PFileTransfer.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="P2PFileTransfer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="400"
        Icon="/Assets/avalonia-logo.ico"
        Title="P2P File Transfer"
        DragDrop.AllowDrop="True">
    <DockPanel>
        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             Width="100"
                             Height="4"
                             Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Display Name:"
                           VerticalAlignment="Center" />
                <TextBox Width="200"
                         Text="{Binding DisplayName, Mode=TwoWay}"
                         MaxLength="64"
                         Watermark="Enter your name" />
                <Button Content="Start Discovery"
                        Command="{Binding StartDiscoveryCommand}" />
                <Button Content="Stop Discovery"
                        Command="{Binding StopDiscoveryCommand}" />
                <Button Content="Send File"
                        Command="{Binding SendFileCommand}" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Margin="12" ColumnDefinitions="*,12,*">
            <!-- Peers Panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Discovered Peers"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top"
                               IsVisible="{Binding !Peers.Count}"
                               Text="No peers discovered. Start discovery to find peers on your network."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="0,8,0,0" />
                    <ListBox ItemsSource="{Binding Peers}"
                             SelectedItem="{Binding SelectedPeer}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PeerItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Endpoint}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LastSeenText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Transfers Panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Name="TransfersPanel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Transfers"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top"
                               IsVisible="{Binding !Transfers.Count}"
                               Text="No active transfers. Select a peer and drag files here or click Send File."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="0,8,0,0" />
                    <ListBox ItemsSource="{Binding Transfers}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferItemViewModel">
                                <Border CornerRadius="4"
                                        Padding="12"
                                        Margin="0,4">
                                    <Border.Background>
                                        <MultiBinding Converter="{x:Static vm:TransferItemViewModel.BackgroundConverter}">
                                            <Binding Path="IsFinished" />
                                            <Binding Path="IsSuccess" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                        <!-- Row 0: Title, File Size, and Close Button -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileSizeText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    FontSize="10"
                                                    Padding="6,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="OnRemoveTransferClick"
                                                    Tag="{Binding TransferId}"
                                                    ToolTip.Tip="Remove transfer" />
                                        </Grid>

                                        <!-- Row 1: Remote Endpoint and Timestamp -->
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,2,0,6">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding RemoteEndpoint}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StartedAtText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                       Margin="12,0,0,0" />
                                        </Grid>

                                        <!-- Row 2: Progress Bar -->
                                        <ProgressBar Grid.Row="2"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent}"
                                                     Height="6"
                                                     Margin="0,0,0,6" />

                                        <!-- Row 3: Status, Speed, Progress, ETA -->
                                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StatusText}"
                                                       FontSize="12" />
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="12">
                                                <TextBlock Text="{Binding ProgressText}"
                                                           FontSize="11"
                                                           IsVisible="{Binding !IsFinished}"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                <TextBlock Text="{Binding SpeedText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           IsVisible="{Binding SpeedText.Length}" />
                                                <TextBlock Text="{Binding EtaText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           IsVisible="{Binding EtaText.Length}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
