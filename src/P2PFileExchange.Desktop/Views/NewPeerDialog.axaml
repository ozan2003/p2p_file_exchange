<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="P2PFileExchange.Desktop.Views.NewPeerDialog"
        Title="New Peer Detected"
        Width="480"
        Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="True"
        Topmost="True">

  <Border Padding="24">
    <Grid RowDefinitions="Auto,*,Auto,Auto">

      <!-- Header -->
      <StackPanel Grid.Row="0" Spacing="8">
        <TextBlock Text="New Peer Connection"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="PeerNameText"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </StackPanel>

      <!-- Fingerprint Display -->
      <Border Grid.Row="1"
              Background="{DynamicResource SystemControlBackgroundListLowBrush}"
              CornerRadius="6"
              Padding="16"
              Margin="0,16,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="Verify this fingerprint with the peer:"
                     FontSize="12"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          <TextBlock x:Name="FingerprintText"
                     FontFamily="Consolas,Monaco,monospace"
                     FontSize="14"
                     TextWrapping="Wrap"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     Margin="0,8" />
          <TextBlock Text="This fingerprint uniquely identifies the peer. Verify it matches what the peer sees on their device."
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
      </Border>

      <!-- Warning -->
      <Border Grid.Row="2"
              Background="#44FFAA00"
              CornerRadius="4"
              Padding="12"
              Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="Trusting this peer will allow secure file transfers. Only trust peers you know."
                     FontSize="12"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Buttons -->
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="12"
                  Margin="0,16,0,0">
        <Button x:Name="BlockButton"
                Content="Block"
                Width="90"
                Click="OnBlockClick"
                ToolTip.Tip="Block this peer from future connections" />
        <Button x:Name="RejectButton"
                Content="Not Now"
                Width="90"
                Click="OnRejectClick"
                ToolTip.Tip="Decline without blocking" />
        <Button x:Name="TrustButton"
                Content="Trust"
                Width="90"
                Classes="accent"
                Click="OnTrustClick"
                ToolTip.Tip="Trust this peer for secure transfers" />
      </StackPanel>

    </Grid>
  </Border>
</Window>
