<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="P2PFileExchange.Desktop.Views.TransferConfirmationDialog"
        Title="Incoming File Transfer"
        Width="420"
        Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="True"
        Topmost="True">

  <Border Padding="24">
    <Grid RowDefinitions="*,Auto">

      <!-- Content -->
      <StackPanel Grid.Row="0" Spacing="8">
        <TextBlock x:Name="SenderText"
                   TextWrapping="Wrap"
                   FontSize="14" />
        <TextBlock x:Name="FileInfoText"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="12"
                  Margin="0,16,0,0">
        <Button x:Name="RejectButton"
                Content="Reject"
                Width="100"
                Click="OnRejectClick" />
        <Button x:Name="AcceptButton"
                Content="Accept"
                Width="100"
                Classes="accent"
                Click="OnAcceptClick" />
      </StackPanel>

    </Grid>
  </Border>
</Window>
