<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="P2PFileExchange.Desktop.Views.IdentityRegenerateDialog"
        Title="Regenerate Identity"
        Width="450"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Border Padding="20">
    <StackPanel Spacing="16">
      <TextBlock Text="Warning"
                 FontWeight="Bold"
                 FontSize="16" />
      <TextBlock Text="Regenerating your identity will:&#10;&#8226; Create a new cryptographic identity&#10;&#8226; All peers will see you as a new, untrusted peer&#10;&#8226; You will need to verify your new fingerprint with peers&#10;&#10;This action cannot be undone."
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button x:Name="CancelButton"
                Content="Cancel"
                Width="80"
                Click="OnCancelClick" />
        <Button x:Name="RegenerateButton"
                Content="Regenerate"
                Width="100"
                Click="OnRegenerateClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
