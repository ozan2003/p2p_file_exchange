<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="P2PFileExchange.Desktop.Views.PasswordDialog"
        Title="Identity Key Password"
        Width="400"
        SizeToContent="Height"
        MinHeight="280"
        MaxHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.description">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Style>
        <Style Selector="TextBox.passwordBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="20" Spacing="0">
        <!-- Header -->
        <TextBlock x:Name="HeaderText"
                   Classes="header"
                   Text="Unlock Identity Key"/>

        <!-- Description -->
        <TextBlock x:Name="DescriptionText"
                   Classes="description"
                   Text="Enter your password to unlock your identity key."/>

        <!-- Password -->
        <StackPanel>
            <TextBlock Text="Password"/>
            <TextBox x:Name="PasswordBox"
                     Classes="passwordBox"
                     PasswordChar="●"
                     Watermark="Enter password"/>
        </StackPanel>

        <!-- Confirm Password (for new password only) -->
        <StackPanel x:Name="ConfirmPanel" IsVisible="False">
            <TextBlock Text="Confirm Password"/>
            <TextBox x:Name="ConfirmPasswordBox"
                     Classes="passwordBox"
                     PasswordChar="●"
                     Watermark="Confirm password"/>
        </StackPanel>

        <!-- Error message -->
        <TextBlock x:Name="ErrorText"
                   Classes="error"
                   IsVisible="False"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    Click="OnCancelClick"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="80"
                    Classes="accent"
                    Click="OnOkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
